<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="64" height="64">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#2A2F33"/>
      <stop offset="100%" stop-color="#151718"/>
    </linearGradient>
    <linearGradient id="brandOrange" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FF7A45"/>
      <stop offset="100%" stop-color="#E85D2A"/>
    </linearGradient>
    <linearGradient id="glowGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#E85D2A" stop-opacity="0.3"/>
      <stop offset="100%" stop-color="#E85D2A" stop-opacity="0"/>
    </linearGradient>
  </defs>

  <!-- Background with subtle border and rounded corners -->
  <rect width="64" height="64" rx="14" fill="url(#bgGrad)"/>
  <rect x="0.75" y="0.75" width="62.5" height="62.5" rx="13.25" fill="none" stroke="#E85D2A" stroke-width="1.5" stroke-opacity="0.35"/>
  <circle cx="32" cy="32" r="24" fill="url(#glowGrad)"/>

  <!-- VeloPeak Mountain Crest / Velocity V Accent -->
  <path d="M22 22 L32 14 L42 22" fill="none" stroke="#E85D2A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" opacity="0.4"/>

  <!-- Stylized Bicycle Icon -->
  <g fill="none" stroke-linecap="round" stroke-linejoin="round">
    <!-- Rear Wheel -->
    <circle cx="18" cy="41" r="9.5" stroke="#FFFFFF" stroke-width="2.8"/>
    <circle cx="18" cy="41" r="2" fill="#E85D2A"/>

    <!-- Front Wheel -->
    <circle cx="46" cy="41" r="9.5" stroke="#FFFFFF" stroke-width="2.8"/>
    <circle cx="46" cy="41" r="2" fill="#E85D2A"/>

    <!-- Frame Geometry (Orange) -->
    <path d="M18 41 L29 41 L39 29 L28 29 Z" stroke="url(#brandOrange)" stroke-width="3" stroke-linejoin="round"/>
    
    <!-- Seat Tube & Saddle -->
    <path d="M29 41 L25 24" stroke="url(#brandOrange)" stroke-width="3"/>
    <path d="M22 23 L28 23" stroke="#FFFFFF" stroke-width="2.8"/>

    <!-- Fork & Handlebars -->
    <path d="M46 41 L39 29 L37 23 L33 24" stroke="#FFFFFF" stroke-width="2.8"/>
    <path d="M37 23 L41 21" stroke="url(#brandOrange)" stroke-width="2.8"/>

    <!-- Bottom Bracket / Chainring Accent -->
    <circle cx="29" cy="41" r="2.5" fill="#FFFFFF"/>
  </g>
</svg>
